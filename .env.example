# Copy to .env before docker compose or a local `make run`.
# .env is gitignored. Do not put AWS account access keys in this file.
#
# The runtime uses the AWS SDK default credential chain (environment, shared
# config, or an instance role). docker-compose maps the MinIO root user and
# password into that chain for the runtime container. For a real AWS account,
# leave the MinIO variables unused and do not commit credentials.

MINIO_ROOT_USER=localdev
MINIO_ROOT_PASSWORD=localdev-change-me

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

PULSE_S3_ENDPOINT=http://127.0.0.1:9000
PULSE_S3_BUCKET=checkpoints
PULSE_S3_REGION=us-east-1
PULSE_S3_FORCE_PATH_STYLE=true
PULSE_GRPC_ADDR=0.0.0.0:50051
PULSE_METRICS_ADDR=0.0.0.0:9090
PULSE_LOG_LEVEL=info
